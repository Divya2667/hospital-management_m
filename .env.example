# Flask Configuration
FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-hospital-mgmt-academic-project-2025

# MongoDB Connection URI (Local or MongoDB Atlas)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/hospital_management
MONGO_DB_NAME=hospital_management

# Clinic Scheduling Settings
CLINIC_OPEN_TIME=09:00
CLINIC_CLOSE_TIME=17:00
DEFAULT_APPOINTMENT_DURATION=30
